# Google AI Studio / Gemini API Key (Required for direct Gemini calls)
GEMINI_API_KEY=[GCP_API_KEY]

# Optional: Google Cloud Vertex AI Configuration
# Set these if you are using Vertex AI instead of Google AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: ADK Configuration
ADK_ENV=development
ADK_LOG_LEVEL=INFO
