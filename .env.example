# Optional: Google Cloud deployment project and region
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: ADK Configuration
ADK_ENV=development
ADK_LOG_LEVEL=INFO

# All phases: shared Ollama LLM configuration (no Gemini API key needed)
OLLAMA_HOST=http://chips-mac-mini.local:11434
OLLAMA_MODEL=ollama/gemma4:e4b

# Phase 2 cryptocurrency agent: public CoinGecko MCP (no API key required)
COINGECKO_MCP_URL=https://mcp.api.coingecko.com/mcp
